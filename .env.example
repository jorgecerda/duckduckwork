# =============================================================================
# DuckDuckWork (ApplyPilot) Environment Configuration
# =============================================================================
# Copy this file to .env and adjust your configuration:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 1. AI / LLM Configuration (Choose ONE of the following options)
# -----------------------------------------------------------------------------

# OPTION A: Google Gemini (Recommended default: fast & generous free tier)
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model override (defaults to gemini-2.0-flash)
# LLM_MODEL=gemini-2.0-flash

# OPTION B: OpenAI (GPT-4o, GPT-4o-mini)
# OPENAI_API_KEY=sk-proj-...
# LLM_MODEL=gpt-4o-mini

# OPTION C: Ollama (100% Free, Private & Local - No API key needed)
# Run `ollama run llama3.2` locally, then configure:
# LLM_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2

# OPTION D: DeepSeek
# LLM_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-chat

# OPTION E: Groq (Ultra-fast cloud inference)
# LLM_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile

# OPTION F: OpenRouter (Anthropic Claude, Mistral, Meta Llama)
# LLM_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=anthropic/claude-3.5-sonnet

# -----------------------------------------------------------------------------
# 2. Server & Security Settings
# -----------------------------------------------------------------------------

# Port for the DuckDuckWork HTTP server (Default: 8000)
PORT=8000

# Admin Control Panel Password (Required for /admin access)
ADMIN_PASSWORD=change_this_to_a_secure_password

# Base data directory for SQLite database, logs, and sessions (Default: .data)
APPLYPILOT_DIR=.data

# -----------------------------------------------------------------------------
# 3. Proxy & Scraping Settings (Optional)
# -----------------------------------------------------------------------------

# Webshare API key for rotating proxy list & bandwidth monitoring
# WEBSHARE_API_KEY=your_webshare_api_key_here

# Direct HTTP/SOCKS5 proxy override (e.g., http://user:pass@host:port)
# APPLYPILOT_PROXY=http://user:pass@host:port

